{
  "name": "@xiaotuchu/dsh-theme-eye-care",
  "version": "2.1.0",
  "description": "护眼配色 Eye-care palettes — three switchable low-glare themes (warm paper, eye green, warm grey) for the DeepSeek Harness web GUI, each a full alias-token layer with a light and a dark face.",
  "license": "MIT",
  "author": "Xiaotu",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./themes/*": "./themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "themes",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "preview.png",
    "preview-en.png"
  ],
  "scripts": {
    "build": "node src/build.js",
    "check": "node src/build.js --check",
    "test": "node test/run.js",
    "test:install": "node test/install.test.js",
    "index": "node tools/palette-index.js",
    "preview": "python tools/render-preview.py preview.png",
    "preview:en": "python tools/render-preview.py preview-en.png --lang en"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "palette",
    "eye-care",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaotuchu/dsh-theme-eye-care.git"
  },
  "homepage": "https://github.com/xiaotuchu/dsh-theme-eye-care#readme",
  "bugs": {
    "url": "https://github.com/xiaotuchu/dsh-theme-eye-care/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  }
}